{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalendarix",
  "mainBinaryName": "kalendarix",
  "version": "2.0.0",
  "identifier": "sk.esyst.kalendarix",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first desktop calendar",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../gammu": "gammu" }
  }
}
