{
  "name": "kalendarix",
  "private": true,
  "version": "2.0.0",
  "description": "Local-first desktop calendar: Tauri (Rust) shell, TypeScript UI.",
  "author": "esyst",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc-rs --noEmit && vite build",
    "typecheck": "tsc-rs --noEmit",
    "lint": "oxlint src e2e",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tauri": "tauri",
    "e2e": "node e2e/run.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@tauri-apps/api": "^2.12.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.2",
    "happy-dom": "^21.0.1",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.64.0",
    "tsc-rs": "0.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "tsc-rs": false
  }
}
